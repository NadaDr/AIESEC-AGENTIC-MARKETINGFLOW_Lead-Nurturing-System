# ==========================================
# Lead Nurturing System - Environment Setup
# ==========================================

# --- EXPA / AIESEC API Configuration ---
EXPA_API_URL=https://gis-api.aiesec.org/graphql
EXPA_API_TOKEN=your_expa_graphql_jwt_token_here

AIESEC_API_URL=https://gis-api.aiesec.org/graphql
AIESEC_API_TOKEN=your_aiesec_graphql_token_here

# --- MySQL Database Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aiesec_agentic_marketingflow
MYSQL_USER=root
MYSQL_PASSWORD=

# --- SMTP Mail Configuration (Gmail / Mailtrap) ---
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your_email@gmail.com
MAIL_SMTP_PASSWORD=your_app_password_here
MAIL_FROM=your_email@gmail.com

# --- Ollama AI Configuration (Agent Client) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
